[Unit]
Description=LeadForge AI Backend
After=network.target

[Service]
Type=simple
User=leadforge
Group=leadforge
WorkingDirectory=/opt/leadforge/backend
EnvironmentFile=/opt/leadforge/backend/.env
ExecStart=/opt/leadforge/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --timeout-keep-alive 120
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=leadforge-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
