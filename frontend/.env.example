# Copy to .env.local for local development, or set these in Vercel (Settings -> Environment Variables)
# NOTE: NEXT_PUBLIC_* vars are inlined at build time — set them in Vercel BEFORE building.

# --- Backend / API ---
# URL of the deployed FastAPI backend. In dev: http://localhost:8000
# On Vercel this is used by rewrites() to proxy /api/* to your Python backend.
NEXT_PUBLIC_API_URL=https://YOUR_API_DOMAIN

# --- Supabase ---
# Project URL and anon (public) key from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Payments (Razorpay) ---
# Public key ID (rzp_test_xxx for test, rzp_live_xxx for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# --- AI (hyper-agent subsystem, ALL OPTIONAL) ---
# The core app never uses these — AI runs on the FastAPI backend with its own
# OPENAI_API_KEY. These only power the (currently unwired) hyper-agent lead
# finder. GOOGLE_SEARCH_API_KEY also requires GOOGLE_SEARCH_CX, otherwise the
# Google source falls back to fake leads.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY
# GOOGLE_SEARCH_CX=YOUR_CUSTOM_SEARCH_ENGINE_ID
# GEMINI_API_KEY is NOT used by any code — do not configure it.

# --- Vercel build optimizations ---
# Skip Playwright browser download during Vercel builds (only types are imported)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
